# EP051 environment template. Version 1.0.0 (2026-08-23).
EP051_ENVIRONMENT=development
EP051_HTTP_PORT=8080
EP051_DB_NAME=ep051
EP051_DB_USER=ep051_app
EP051_DB_PASSWORD=__REQUIRED_SECRET_FROM_VAULT_OR_LOCAL_SECRET_STORE__
EP051_DB_PORT=5432
EP051_CACHE_PORT=6379
EP051_SNAPSHOT=not-published
EP051_LOG_LEVEL=INFO
EP051_OPEN_STATE_TTL_SECONDS=5
EP051_CLOSED_SNAPSHOT_MAX_AGE_SECONDS=86400
EP051_BROKER_PROFILE=disabled

