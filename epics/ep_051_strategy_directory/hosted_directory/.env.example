# Version history: 1.0.0 (2026-08-23) local and hosted configuration template.
DATA_BACKEND=sqlserver
DB_SERVER=tcp:YOUR_LOCAL_SQL_SERVER,1433
DB_NAME=tradedb
DB_USER=YOUR_READ_ONLY_USER
DB_PASS=SET_OUTSIDE_SOURCE_CONTROL
# Hosted mode: DATA_BACKEND=postgres and DATABASE_URL=postgresql://...
DATABASE_URL=
# Hosted retention only: dedicated NOSUPERUSER/NOBYPASSRLS role with only EXECUTE on intelligence_purge_expired_history().
MAINTENANCE_DATABASE_URL=
SYNC_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
