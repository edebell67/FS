# Copy to .env.local for local dev. Real values live in Render's encrypted
# environment settings in production — never commit a filled-in copy.

# Render Postgres external connection string (or local Postgres for dev).
DATABASE_URL=postgres://user:***@localhost:5432/ep047_directory

NODE_ENV=development

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Gmail API OAuth for the already-verified, fixed sender
# edward.bell@thetechprinciple.com. All values are required to send; leaving
# any blank keeps preview available and fails closed. Never expose or log them.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Public site URL for general site metadata. Verification capability links use
# https://thetechprinciple.com in production and this localhost value only in
# genuine local development.
NEXT_PUBLIC_SITE_URL=http://localhost:8140

# Keep disabled by default. Real sending requires mode=gmail-api, approval=true,
# complete OAuth configuration, a public production origin, and an authenticated
# administrator's explicit confirmation. The recipient is the selected business's
# current recorded email address; the From identity is fixed in application code.
VERIFICATION_DELIVERY_MODE=disabled
VERIFICATION_DELIVERY_APPROVED=false

# Real registered business address shown in the verification email's sender
# signature. Required before sending to any real (non-test) recipient; the
# template falls back to a visible placeholder if this is unset.
VERIFICATION_SENDER_ADDRESS=

# Claim-success messages are sent only after an admin explicitly approves the
# selected claims. Keep disabled until an authorised rollout supplies the exact
# approved recipient allowlist; prepared is never represented as sent.
CLAIM_SUCCESS_DELIVERY_MODE=disabled
CLAIM_SUCCESS_DELIVERY_APPROVED=false
CLAIM_SUCCESS_RECIPIENT_ALLOWLIST=

# Preview-ready / ETA / ready-for-activation messages, plus their reminder
# nudges. Same fail-closed pattern: disabled until explicitly approved with a
# non-empty allowlist. Payment (activation itself) is a separate, later unit.
PREVIEW_DELIVERY_MODE=disabled
PREVIEW_DELIVERY_APPROVED=false
PREVIEW_RECIPIENT_ALLOWLIST=

# Bearer key for the internal (infrastructure-only) API used by the site-
# generation cron job: GET /api/internal/site-generation/queue, POST .../complete,
# POST .../notify. Fails closed if unset -- an empty value never means "skip auth".
INTERNAL_API_KEY=

# Public origin the generation loop uses to call the internal API above and to
# build the siteUrl recorded on each business (e.g. https://directory.example.com).
PUBLIC_APP_ORIGIN=

# Site-generation loop (lib/generation/). GENERATION_MODE picks exactly one
# active path -- "local" (the existing deploying agent runs ep044_group skills
# itself under your Claude subscription, no per-call cost -- see
# workstream/600_workflow/ep047_local_generation_agent_instructions.md) or
# "hosted" (this app's own Render cron + LLM API, built but left off by
# default). Never set both; the inactive path must not touch the queue.
# GENERATION_MODE: "local" | "hosted"
GENERATION_MODE=local

# Only read when GENERATION_MODE=hosted. Leave LLM_PROVIDER unset to keep the
# hosted loop a clean no-op -- it is never treated as a failure, just "not yet ready".
# LLM_PROVIDER: "anthropic" | "openai"
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
