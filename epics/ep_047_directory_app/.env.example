# Copy to .env.local for local dev. Real values live in Render's encrypted
# environment settings in production — never commit a filled-in copy.

# Render Postgres external connection string (or local Postgres for dev).
DATABASE_URL=postgres://user:password@localhost:5432/ep047_directory

NODE_ENV=development

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Reserved for Phase 2+ (verification email sender). Leave blank until wired up.
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# Public site URL for general site metadata. Verification capability links use
# https://thetechprinciple.com in production and this localhost value only in
# genuine local development.
NEXT_PUBLIC_SITE_URL=http://localhost:8140

# Outbound delivery remains disabled. Current implementation is preview/copy only.
# No provider is implemented. "audit_only" still cannot send and additionally
# requires explicit approval; the safe default is disabled.
VERIFICATION_DELIVERY_MODE=disabled
VERIFICATION_DELIVERY_APPROVED=false
