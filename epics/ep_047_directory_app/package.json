{
  "name": "ep047-directory-app",
  "version": "0.3.0",
  "private": true,
  "description": "Business Activation Directory Platform — directory, activation pipeline, and operational control centre.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 8140",
    "build": "next build",
    "start": "next start -p ${PORT:-8140}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "news:seed": "tsx scripts/seed-news-from-static.ts",
    "news:import": "tsx scripts/import-news-batches.ts",
    "generate:sites": "tsx scripts/generate-sites.ts",
    "auth:create-admin": "tsx scripts/create-admin.ts",
    "test": "tsx --env-file=.env.local --test tests/*.test.ts ep047_visibility_news/*.test.ts ep047_visibility_news/admin/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "next": "^15.1.4",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
